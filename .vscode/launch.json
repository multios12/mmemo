{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Debug",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/mmemo",
      "cwd": "${workspaceFolder}/data",
      "args": [
        "-p",
        ":3001"
      ]
    },
    {
      "name": "Open Front in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/front",
      "preLaunchTask": "front: dev",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "vite://*": "${workspaceFolder}/front/*",
        "/@fs/*": "*",
        "src/*": "${workspaceFolder}/front/src/*",
        "/*": "${workspaceFolder}/front/*"
      }
    },
  ],
  "compounds": [
    {
      "name": "Dev: Front + API",
      "configurations": [
        "API Debug",
        "Open Front in Edge"
      ]
    }
  ]
}
